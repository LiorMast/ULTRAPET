# .env.example — Template of .env, the local secrets read by compose.yaml. Copy it to .env (git-ignored) and fill
# in the values. POSTGRES_PASSWORD must match the password in .mcp.json's DATABASE_URI (the postgres MCP), and must
# be URL-safe (letters, digits, - and _), because it is also part of DATABASE_URL.
POSTGRES_PASSWORD=change-me
# Flask secret: signs the sign-in tokens (JWTs). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# Optional: `flask seed` creates a staff admin with these credentials when both are set.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional: `flask seed` creates a demo business customer with these credentials when both are set (sign in with
# them to see prices in the catalog). The e2e tests (frontend/e2e) sign in with them too, so set them for e2e.
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=
# The host port of the Flask backend in dev (compose.yaml, Vite's /api proxy, the e2e tests); empty = 5000. Set
# another one (e.g. 5001) when a different app already uses 5000.
BACKEND_PORT=
# 1 = the sign-in cookies are sent over https only. Leave unset in dev and in the HTTP demo (compose.prod.yaml).
JWT_COOKIE_SECURE=
# The file storage of the pictures and the PDF catalog (backend/app/storage.py). Empty or "local" = the local stub:
# files in backend/media, served at /api/media/<key>. "s3" = an S3 bucket (run `flask push-media` once to copy the
# stub's files into it). The database stores only each file's key (e.g. categories/3f2a.webp); the API builds the URL.
STORAGE_BACKEND=
# The bucket and its region, e.g. S3_BUCKET=ultrapet-media, S3_REGION=eu-central-1 (needed when STORAGE_BACKEND=s3).
# The bucket must allow public reads (a bucket policy on s3:GetObject); the server writes with the keys below.
S3_BUCKET=
S3_REGION=
# Optional: the endpoint of an S3-compatible service (empty = AWS), and the base URL of a CDN or custom domain in
# front of the bucket (empty = https://<bucket>.s3.<region>.amazonaws.com/).
S3_ENDPOINT_URL=
S3_PUBLIC_URL=
# The access key of an IAM user allowed s3:PutObject / GetObject / DeleteObject on the bucket's objects and
# s3:ListBucket on the bucket. Leave empty on a server with an IAM role (boto3 then uses the role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Email (backend/app/mailer.py): staff get an email for every request for a business account. In dev, compose
# sends everything to Mailpit (http://localhost:8025) unless SMTP_HOST is set here. In production, set the SMTP
# server (e.g. SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_TLS=true and the sign-in); empty = the mails are logged.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=
# The sender address (empty = no-reply@ultrapet.co.il), and who receives the staff notifications (comma separated;
# empty = the contact email staff set on the home page, setting contact_email).
MAIL_FROM=
LEADS_NOTIFY_TO=
# The address lookup of the reseller form in /admin/resellers (backend/app/geocode.py): a Nominatim-compatible search
# URL. Leave it out for OpenStreetMap's public Nominatim; set it empty to switch the lookup off.
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
