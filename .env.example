# .env.example — Template of .env, the local secrets read by compose.yaml. Copy it to .env (git-ignored) and fill
# in the values. POSTGRES_PASSWORD must match the password in .mcp.json's DATABASE_URI (the postgres MCP), and must
# be URL-safe (letters, digits, - and _), because it is also part of DATABASE_URL.
POSTGRES_PASSWORD=change-me
# Flask secret: signs the sign-in tokens (JWTs). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# Optional: `flask seed` creates a staff admin with these credentials when both are set.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional: `flask seed` creates a demo business customer with these credentials when both are set (sign in with
# them to see prices in the catalog). The e2e tests (frontend/e2e) sign in with them too, so set them for e2e.
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=
# Production only: 1 = the sign-in cookies are sent over https only. Leave unset in dev (plain http).
JWT_COOKIE_SECURE=
# The S3 bucket of the uploaded pictures and its region, e.g. S3_BUCKET=ultrapet-media, S3_REGION=eu-central-1. The
# database stores only each picture's key (e.g. categories/3f2a.webp); the API builds the URL
# https://<bucket>.s3.<region>.amazonaws.com/<key> from these. Leave both empty while the files are kept by the local
# stub (backend/app/storage.py): the URLs are then /api/media/<key>.
S3_BUCKET=
S3_REGION=
# Demo deployment only (compose.prod.yaml): the public host name Caddy serves with HTTPS, e.g. 3.120.1.2.sslip.io.
SITE_ADDRESS=
