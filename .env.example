# .env.example — Template of .env, the local secrets read by compose.yaml. Copy it to .env (git-ignored) and fill
# in the values. POSTGRES_PASSWORD must match the password in .mcp.json's DATABASE_URI (the postgres MCP), and must
# be URL-safe (letters, digits, - and _), because it is also part of DATABASE_URL.
POSTGRES_PASSWORD=change-me
# Flask secret for signed cookies (sign-in sessions, Phase 4). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# Optional: `flask seed` creates a staff admin with these credentials when both are set.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
